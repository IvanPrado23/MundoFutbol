# ==============================================================
# J&A Mundo Fútbol - Configuración de Variables de Entorno
# Copia este archivo como .env.local para personalizar tus valores
# ==============================================================

# 1. Contraseña del Panel de Administrador (Modo directo)
# Define aquí la contraseña con la que ingresarás a /admin:
NEXT_PUBLIC_ADMIN_PASSWORD=futbol2026

# 2. Configuración de Firebase (Opcional - Cuando crees tu proyecto en console.firebase.google.com)
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mundo-futbol-xxxx.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=mundo-futbol-xxxx
# NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxx:web:xxxx

# 3. Configuración de Cloudinary (Opcional - Para subir fotos a la nube gratis sin tarjeta)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_unsigned_preset
